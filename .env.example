# ==============================================================================
# ELEVRA EXECUTIVE CONFIDENCE COACH - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# In production on Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit actual API keys, database credentials, or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
# Production: https://your-production-domain.com
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://clerk.com)
# ------------------------------------------------------------------------------
# Sourced from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk internal routing paths (defaults provided)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app/onboarding"

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon PostgreSQL - https://neon.tech)
# ------------------------------------------------------------------------------
# Sourced from Neon Console -> Connection Details (Pooled connection string recommended)
DATABASE_URL="postgresql://username:password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 4. CREDENTIAL ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# Used to encrypt and decrypt sensitive user credentials (such as Gmail App Passwords)
# stored in the database. Must be exactly a 64-character lowercase hex string (32 bytes).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_ENCRYPTION_KEY="your_64_character_hex_encryption_key_generated_via_crypto_bytes"
# ENCRYPTION_KEY is also accepted as a backwards-compatible alias:
# ENCRYPTION_KEY="your_64_character_hex_encryption_key_generated_via_crypto_bytes"

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE (NVIDIA NIM - https://build.nvidia.com)
# ------------------------------------------------------------------------------
# Sourced from NVIDIA API Catalog (NVIDIA NGC / NIM account)
NVIDIA_API_KEY="nvapi-..."
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.1-70b-instruct"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend - https://resend.com)
# ------------------------------------------------------------------------------
# Primary transactional email provider for weekly check-ins and test digests
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Elevra Coach <coach@yourdomain.com>"

# ------------------------------------------------------------------------------
# 7. SCHEDULED JOBS & CRON SECURITY (Vercel Cron)
# ------------------------------------------------------------------------------
# Secret token used by Vercel Cron to authorize weekly check-in dispatches.
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/weekly-checkin.
# Must be at least 16 random characters.
# Generate using: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="your_secure_random_cron_secret_token_here"
