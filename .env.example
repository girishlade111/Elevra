# ==============================================================================
# AI CONFIDENCE COACH - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app/onboarding"

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon PostgreSQL - https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AES-256-GCM encryption key for sensitive credentials (Gmail App Passwords).
# Must be a 64-character lowercase hex string (32 bytes).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_char_hex_string_here_generated_with_the_command_above_xx"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (NVIDIA NIM - https://build.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY="nvapi-..."
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY PROVIDERS (Choose Resend or Gmail SMTP)
# ------------------------------------------------------------------------------
# Option A: Resend (https://resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="coach@yourdomain.com"

# Option B: Gmail SMTP with App Password
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ------------------------------------------------------------------------------
# 6. SCHEDULED JOBS (Vercel Cron)
# ------------------------------------------------------------------------------
CRON_SECRET="your_long_random_secure_cron_secret_token"
